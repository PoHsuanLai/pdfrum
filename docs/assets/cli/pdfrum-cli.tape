# CLI showcase. Regenerated by ./scripts/record-cli.nu — do not hand-edit
# the GIF. Settings and sleeps are part of the picture: change them here.

Output docs/assets/cli/pdfrum-cli.gif

Require pdfrum

Set Shell "bash"
Set FontFamily "DejaVu Sans Mono"
Set FontSize 16
Set Width 960
Set Height 540
Set Padding 20
Set CursorBlink false
Set TypingSpeed 45ms
Set Framerate 12
Set WaitTimeout 10s
Set Theme { "name": "pdfrum", "background": "#0d0e10", "foreground": "#f2f0ea", "cursor": "#f06a9b", "selection": "#3a2a32", "black": "#1c1d21", "red": "#e01b24", "green": "#7aab7d", "yellow": "#d4b483", "blue": "#6b8ca8", "magenta": "#f06a9b", "cyan": "#8ec8c8", "white": "#f2f0ea", "brightBlack": "#6b6762", "brightRed": "#e01b24", "brightGreen": "#8fbf91", "brightYellow": "#e0c07a", "brightBlue": "#8aa9c0", "brightMagenta": "#f06a9b", "brightCyan": "#a8d8d8", "brightWhite": "#faf8f8" }

Hide
Type "export PS1='$ '"
Enter
Sleep 300ms
Type "cd /tmp/pdfrum-cli-demo"
Enter
Sleep 300ms
Ctrl+L
Show

Type "pdfrum info report.pdf"
Enter
Sleep 1.8s

Type "pdfrum doctor damaged.pdf"
Enter
Sleep 2.4s

Type "pdfrum extract toc report.pdf"
Enter
Sleep 2s

Type "pdfrum search ISO paper.pdf"
Enter
Sleep 3s
